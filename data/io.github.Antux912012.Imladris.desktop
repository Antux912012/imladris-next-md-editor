[Desktop Entry]
Name=Imladris
Comment=Native GTK4 and Libadwaita Markdown Editor
Exec=imladris %F
Icon=io.github.Antux912012.Imladris
Terminal=false
Type=Application
Categories=GNOME;GTK;Utility;TextEditor;
MimeType=text/markdown;text/x-markdown;text/plain;application/x-ipynb+json;application/json;text/x-r-markdown;
StartupNotify=true
