<?xml version="1.0" encoding="UTF-8"?>
<language id="markdown-custom" name="Markdown (Imladris)" version="2.0" _section="Markup">
  <metadata>
    <property name="mimetypes">text/x-markdown;text/markdown;text/x-r-markdown;application/x-ipynb+json</property>
    <property name="globs">*.md;*.markdown;*.qmd;*.Rmd;*.rmd;*.ipynb</property>
  </metadata>

  <styles>
    <style id="header" name="Header" map-to="def:heading"/>
    <style id="strong" name="Strong" map-to="def:strong"/>
    <style id="emphasis" name="Emphasis" map-to="def:emphasis"/>
    <style id="code" name="Code" map-to="def:inline-code"/>
    <style id="code-block" name="Code Block" map-to="def:code-block"/>
    <style id="block-quote" name="Block Quote" map-to="def:comment"/>
    <style id="link" name="Link" map-to="def:underlined"/>
    <style id="bullet" name="Bullet" map-to="def:special-char"/>
    <style id="horizontal-rule" name="Horizontal Rule" map-to="def:statement"/>
  </styles>

  <definitions>
    <context id="header" style-ref="header">
      <match>^(#{1,6})\s+.*$</match>
    </context>

    <context id="strong" style-ref="strong">
      <match>(\*\*|__)(?!\s).+?(?&lt;!\s)\1</match>
    </context>

    <context id="emphasis" style-ref="emphasis">
      <match>(\*|_)(?!\s).+?(?&lt;!\s)\1</match>
    </context>

    <context id="code" style-ref="code">
      <match>`[^`]+`</match>
    </context>

    <context id="code-block" style-ref="code-block">
      <start>^```.*$</start>
      <end>^```$</end>
    </context>

    <context id="block-quote" style-ref="block-quote">
      <match>^\s*&gt;\s+.*$</match>
    </context>

    <context id="bullet" style-ref="bullet">
      <match>^\s*([*+-]|\d+\.)\s+</match>
    </context>

    <context id="link" style-ref="link">
      <match>\[.*?\]\(.*?\)</match>
    </context>

    <context id="horizontal-rule" style-ref="horizontal-rule">
      <match>^(-{3,}|\*{3,}|_{3,})$</match>
    </context>

    <context id="markdown-custom">
      <include>
        <context ref="code-block"/>
        <context ref="header"/>
        <context ref="strong"/>
        <context ref="emphasis"/>
        <context ref="code"/>
        <context ref="block-quote"/>
        <context ref="bullet"/>
        <context ref="link"/>
        <context ref="horizontal-rule"/>
      </include>
    </context>
  </definitions>
</language>
