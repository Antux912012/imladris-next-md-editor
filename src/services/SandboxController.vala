namespace Imladris.Services {

    public class SandboxController : GLib.Object {

        /**
         * Pillars 6 & 7: Manages renv (R) and venv (Python) sandboxes based on primary format.
         */
        public static async void init_sandbox (string project_root, DocumentFormat fmt) throws GLib.Error {
            var launcher = new SubprocessLauncher (SubprocessFlags.STDOUT_PIPE | SubprocessFlags.STDERR_MERGE);
            launcher.set_cwd (project_root);

            if (fmt == DocumentFormat.RMD || fmt == DocumentFormat.QMD) {
                string[] r_argv = {
                    "Rscript",
                    "-e",
                    "if (!requireNamespace('renv', quietly=TRUE)) install.packages('renv', repos='https://cloud.r-project.org'); renv::init(bare = TRUE, restart = FALSE); renv::snapshot(prompt = FALSE)"
                };
                try {
                    var r_proc = launcher.spawnv (r_argv);
                    yield r_proc.wait_check_async ();
                } catch (GLib.Error e) {
                    // Fall back to stub initialization
                    init_r_sandbox (project_root);
                }
            }

            if (fmt == DocumentFormat.IPYNB || fmt == DocumentFormat.QMD) {
                string[] py_argv = { "python3", "-m", "venv", ".venv" };
                try {
                    var py_proc = launcher.spawnv (py_argv);
                    yield py_proc.wait_check_async ();
                } catch (GLib.Error e) {
                    init_py_sandbox (project_root);
                }

                string req_path = Path.build_filename (project_root, "requirements.txt");
                if (!FileUtils.test (req_path, FileTest.EXISTS)) {
                    FileUtils.set_contents (req_path, "# Imladris Sandboxed Python Dependencies\n");
                }
            }
        }

        public static void export_to_rstudio (string project_path, string dest_path) throws GLib.Error {
            export_for_rstudio (project_path, dest_path);
        }

        public static void export_to_jupyter (string project_path, string dest_path) throws GLib.Error {
            export_for_jupyter (project_path, dest_path);
        }

        /**
         * Initializes an isolated R sandbox in project_path using renv.
         * Generates .Rprofile, renv/activate.R, and renv.lock.
         */
        public static void init_r_sandbox (string project_path) throws GLib.Error {
            File pdir = File.new_for_path (project_path);
            if (!pdir.query_exists ()) {
                pdir.make_directory_with_parents (null);
            }

            // Ensure renv directory exists
            string renv_dir = Path.build_filename (project_path, "renv");
            File rdir = File.new_for_path (renv_dir);
            if (!rdir.query_exists ()) {
                rdir.make_directory_with_parents (null);
            }

            // Try running renv::init(bare = TRUE) via Rscript if available
            bool rscript_succeeded = false;
            if (Core.PlatformUtils.is_program_available ("Rscript")) {
                try {
                    var launcher = new SubprocessLauncher (SubprocessFlags.STDOUT_PIPE | SubprocessFlags.STDERR_MERGE);
                    if (project_path != "") launcher.set_cwd (project_path);
                    string[] raw_argv = { "Rscript", "-e", "if (requireNamespace('renv', quietly=TRUE)) { renv::init(bare = TRUE); renv::snapshot(prompt = FALSE); }" };
                    string[] argv = Core.PlatformUtils.build_host_command (raw_argv, project_path);
                    var proc = launcher.spawnv (argv);
                    rscript_succeeded = proc.wait_check ();
                } catch (GLib.Error e) {
                    rscript_succeeded = false;
                }
            }

            // Ensure .Rprofile exists
            string rprofile_path = Path.build_filename (project_path, ".Rprofile");
            File rprofile = File.new_for_path (rprofile_path);
            if (!rprofile.query_exists ()) {
                FileUtils.set_contents (rprofile_path, "source(\"renv/activate.R\")\n");
            }

            // Ensure renv/activate.R bootstrap stub exists
            string activate_path = Path.build_filename (renv_dir, "activate.R");
            File activate_file = File.new_for_path (activate_path);
            if (!activate_file.query_exists ()) {
                string stub = """# renv activation bootstrap generated by Imladris
local({
  if (!requireNamespace("renv", quietly = TRUE)) {
    message("* renv not found; installing renv from CRAN...")
    install.packages("renv", repos = "https://cloud.r-project.org")
  }
  renv::activate()
})
""";
                FileUtils.set_contents (activate_path, stub);
            }

            // Ensure renv.lock schema exists
            string lock_path = Path.build_filename (project_path, "renv.lock");
            File lock_file = File.new_for_path (lock_path);
            if (!lock_file.query_exists ()) {
                string lock_stub = """{
  "R": {
    "Version": "4.3.0",
    "Repositories": [
      {
        "Name": "CRAN",
        "URL": "https://cloud.r-project.org"
      }
    ]
  },
  "Packages": {}
}
""";
                FileUtils.set_contents (lock_path, lock_stub);
            }
        }

        /**
         * Initializes an isolated Python virtual environment in project_path (.venv)
         * with pinned requirements.txt and a dedicated Jupyter kernelspec.
         */
        public static void init_py_sandbox (string project_path) throws GLib.Error {
            File pdir = File.new_for_path (project_path);
            if (!pdir.query_exists ()) {
                pdir.make_directory_with_parents (null);
            }

            string venv_dir = Path.build_filename (project_path, ".venv");
            File vdir = File.new_for_path (venv_dir);

            // 1. Create .venv if not present
            if (!vdir.query_exists () && Environment.find_program_in_path ("python3") != null) {
                try {
                    var launcher = new SubprocessLauncher (SubprocessFlags.STDOUT_PIPE | SubprocessFlags.STDERR_MERGE);
                    launcher.set_cwd (project_path);
                    string[] argv = { "python3", "-m", "venv", ".venv" };
                    var proc = launcher.spawnv (argv);
                    proc.wait_check ();
                } catch (GLib.Error e) {
                    // venv creation failed
                }
            }

            // 2. Write initial requirements.txt if not present
            string req_path = Path.build_filename (project_path, "requirements.txt");
            File req_file = File.new_for_path (req_path);
            if (!req_file.query_exists ()) {
                string req_content = """# Imladris Sandboxed Python Dependencies
ipykernel>=6.0.0
jupyter-client>=8.0.0
matplotlib>=3.7.0
pandas>=2.0.0
numpy>=1.24.0
""";
                FileUtils.set_contents (req_path, req_content);
            }

            // 3. Register a local Jupyter kernelspec pointing directly to .venv/bin/python
            string kernel_spec_dir = Path.build_filename (project_path, ".venv", "share", "jupyter", "kernels", "imladris-sandbox");
            File ks_dir = File.new_for_path (kernel_spec_dir);
            if (!ks_dir.query_exists ()) {
                ks_dir.make_directory_with_parents (null);
            }

            string py_bin = Path.build_filename (project_path, ".venv", "bin", "python");
            string kernel_json_path = Path.build_filename (kernel_spec_dir, "kernel.json");
            string kernel_json_content = """{
  "argv": [
    "%s",
    "-m",
    "ipykernel_launcher",
    "-f",
    "{connection_file}"
  ],
  "display_name": "Python 3 (Imladris Sandbox)",
  "language": "python",
  "metadata": {
    "debugger": true
  }
}
""".printf (py_bin);
            FileUtils.set_contents (kernel_json_path, kernel_json_content);
        }

        /**
         * Updates renv.lock and requirements.txt prior to project export.
         */
        public static void snapshot_environment (string project_path) throws GLib.Error {
            // Update R renv.lock if renv exists and Rscript is available
            string renv_dir = Path.build_filename (project_path, "renv");
            if (FileUtils.test (renv_dir, FileTest.IS_DIR) && Core.PlatformUtils.is_program_available ("Rscript")) {
                try {
                    var launcher = new SubprocessLauncher (SubprocessFlags.STDOUT_PIPE | SubprocessFlags.STDERR_MERGE);
                    if (project_path != "") launcher.set_cwd (project_path);
                    string[] raw_argv = { "Rscript", "-e", "if (requireNamespace('renv', quietly=TRUE)) renv::snapshot(prompt = FALSE)" };
                    string[] argv = Core.PlatformUtils.build_host_command (raw_argv, project_path);
                    var proc = launcher.spawnv (argv);
                    proc.wait_check ();
                } catch (GLib.Error e) {
                    // Snapshot skipped or failed
                }
            }

            // Update requirements.txt if .venv exists
            string venv_python = Path.build_filename (project_path, ".venv", "bin", "python");
            if (FileUtils.test (venv_python, FileTest.EXISTS)) {
                try {
                    string[] argv = { venv_python, "-m", "pip", "freeze" };
                    var proc = new Subprocess.newv (argv, SubprocessFlags.STDOUT_PIPE | SubprocessFlags.STDERR_SILENCE);
                    string? output = null;
                    proc.communicate_utf8 (null, null, out output, null);

                    if (output != null && output.strip ().length > 0) {
                        string req_path = Path.build_filename (project_path, "requirements.txt");
                        FileUtils.set_contents (req_path, output.strip () + "\n");
                    }
                } catch (GLib.Error e) {
                    // Snapshot skipped or failed
                }
            }
        }

        /**
         * Restores isolated environment packages from lockfiles (renv::restore() for R,
         * pip install -r requirements.txt for Python).
         */
        public static void restore_environment (string project_path) throws GLib.Error {
            // Restore R renv environment
            string renv_dir = Path.build_filename (project_path, "renv");
            if (FileUtils.test (renv_dir, FileTest.IS_DIR) && Core.PlatformUtils.is_program_available ("Rscript")) {
                try {
                    var launcher = new SubprocessLauncher (SubprocessFlags.STDOUT_PIPE | SubprocessFlags.STDERR_MERGE);
                    if (project_path != "") launcher.set_cwd (project_path);
                    string[] raw_argv = { "Rscript", "-e", "if (requireNamespace('renv', quietly=TRUE)) renv::restore(prompt = FALSE)" };
                    string[] argv = Core.PlatformUtils.build_host_command (raw_argv, project_path);
                    var proc = launcher.spawnv (argv);
                    proc.wait_check ();
                } catch (GLib.Error e) {
                    // Restore failed
                }
            }

            // Restore Python .venv environment
            string venv_python = Path.build_filename (project_path, ".venv", "bin", "python");
            string req_path = Path.build_filename (project_path, "requirements.txt");
            if (FileUtils.test (venv_python, FileTest.EXISTS) && FileUtils.test (req_path, FileTest.EXISTS)) {
                try {
                    string content;
                    FileUtils.get_contents (req_path, out content);
                    bool has_packages = false;
                    foreach (var line in content.split ("\n")) {
                        string trimmed = line.strip ();
                        if (trimmed.length > 0 && !trimmed.has_prefix ("#")) {
                            has_packages = true;
                            break;
                        }
                    }
                    if (has_packages) {
                        string[] argv = { venv_python, "-m", "pip", "install", "-r", req_path };
                        var proc = new Subprocess.newv (argv, SubprocessFlags.STDOUT_PIPE | SubprocessFlags.STDERR_MERGE);
                        proc.wait_check ();
                    }
                } catch (GLib.Error e) {
                    // Restore failed
                }
            }
        }

        /**
         * Exports project for RStudio: bundles project directory with valid <name>.Rproj,
         * .Rprofile, renv/activate.R, and renv.lock.
         */
        public static void export_for_rstudio (string project_path, string dest_path) throws GLib.Error {
            snapshot_environment (project_path);
            MallornManager.sync_rproj_and_mallorn (project_path);

            File dest = File.new_for_path (dest_path);
            if (!dest.query_exists ()) {
                dest.make_directory_with_parents (null);
            }

            // Copy project files recursively
            copy_directory_tree (project_path, dest_path);

            // Validate RStudio bootstrap files in dest_path
            string renv_dir = Path.build_filename (dest_path, "renv");
            File rdir = File.new_for_path (renv_dir);
            if (!rdir.query_exists ()) rdir.make_directory_with_parents (null);

            string rprofile_dest = Path.build_filename (dest_path, ".Rprofile");
            if (!FileUtils.test (rprofile_dest, FileTest.EXISTS)) {
                FileUtils.set_contents (rprofile_dest, "source(\"renv/activate.R\")\n");
            }

            string act_dest = Path.build_filename (renv_dir, "activate.R");
            if (!FileUtils.test (act_dest, FileTest.EXISTS)) {
                FileUtils.set_contents (act_dest, "local({ if (!requireNamespace('renv', quietly=TRUE)) install.packages('renv'); renv::activate() })\n");
            }
        }

        /**
         * Exports project for Jupyter: bundles .ipynb alongside requirements.txt,
         * environment.yml, and an automated setup bootstrap script.
         */
        public static void export_for_jupyter (string project_path, string dest_path) throws GLib.Error {
            snapshot_environment (project_path);

            File dest = File.new_for_path (dest_path);
            if (!dest.query_exists ()) {
                dest.make_directory_with_parents (null);
            }

            copy_directory_tree (project_path, dest_path);

            // Ensure requirements.txt is present for Jupyter environment parity
            string dest_req = Path.build_filename (dest_path, "requirements.txt");
            if (!FileUtils.test (dest_req, FileTest.EXISTS)) {
                FileUtils.set_contents (dest_req, "# Pinned dependencies exported by Imladris for Jupyter\nipykernel>=6.0.0\njupyter-client>=8.0.0\n");
            }

            // Generate environment.yml in destination
            string env_yml = """name: imladris-project
channels:
  - conda-forge
  - defaults
dependencies:
  - python>=3.10
  - ipykernel
  - pip
  - pip:
    - -r requirements.txt
""";
            FileUtils.set_contents (Path.build_filename (dest_path, "environment.yml"), env_yml);

            // Generate setup_environment.sh in destination
            string setup_sh = """#!/usr/bin/env bash
set -e
echo "Bootstrapping Imladris Jupyter Environment..."
python3 -m venv .venv
source .venv/bin/activate
pip install --upgrade pip
if [ -f requirements.txt ]; then
    pip install -r requirements.txt
fi
python -m ipykernel install --user --name imladris-project --display-name "Python 3 (Imladris Export)"
echo "Environment setup complete! Run 'jupyter lab' or 'jupyter notebook' to begin."
""";
            string setup_path = Path.build_filename (dest_path, "setup_environment.sh");
            FileUtils.set_contents (setup_path, setup_sh);
            FileUtils.chmod (setup_path, 0755);
        }

        public static bool is_r_sandbox_active (string project_path) {
            string lock_path = Path.build_filename (project_path, "renv.lock");
            string prof_path = Path.build_filename (project_path, ".Rprofile");
            return FileUtils.test (lock_path, FileTest.EXISTS) || FileUtils.test (prof_path, FileTest.EXISTS);
        }

        public static bool is_py_sandbox_active (string project_path) {
            string venv_bin = Path.build_filename (project_path, ".venv", "bin", "python");
            return FileUtils.test (venv_bin, FileTest.EXISTS);
        }

        public static ProjectType detect_project_type (string project_path) {
            // Check .mallorn.json or imladris.toml
            string json_path = Path.build_filename (project_path, ".mallorn.json");
            if (FileUtils.test (json_path, FileTest.EXISTS)) {
                try {
                    string content;
                    FileUtils.get_contents (json_path, out content);
                    if (content.contains ("\"sandboxed\": true") || content.contains ("\"project_type\": \"Sandboxed\"")) {
                        return ProjectType.SANDBOXED;
                    }
                } catch (GLib.FileError e) {
                    // Ignore file read error and fall through
                }
            }

            string toml_path = Path.build_filename (project_path, "imladris.toml");
            if (FileUtils.test (toml_path, FileTest.EXISTS)) {
                try {
                    string content;
                    FileUtils.get_contents (toml_path, out content);
                    if (content.contains ("sandboxed = true")) {
                        return ProjectType.SANDBOXED;
                    }
                } catch (GLib.FileError e) {
                    // Ignore file read error and fall through
                }
            }

            if (is_r_sandbox_active (project_path) || is_py_sandbox_active (project_path)) {
                return ProjectType.SANDBOXED;
            }

            return ProjectType.STANDARD;
        }

        private static void copy_directory_tree (string src, string dst) throws GLib.Error {
            // Use python3 shutil for cross-platform, recursive copying ignoring heavy local runtime caches
            string py_script = """import os, shutil, sys
src = sys.argv[1]
dst = sys.argv[2]
def ignore_patterns(folder, contents):
    ignored = set()
    for name in contents:
        if name in ('.venv', '__pycache__', '.git', 'build'):
            ignored.add(name)
        elif name.endswith('.pyc'):
            ignored.add(name)
    return ignored
shutil.copytree(src, dst, dirs_exist_ok=True, ignore=ignore_patterns)
""";
            string[] argv = { "python3", "-c", py_script, src, dst };
            var proc = new Subprocess.newv (argv, SubprocessFlags.STDOUT_SILENCE | SubprocessFlags.STDERR_PIPE);
            proc.wait_check ();
        }
    }
}
